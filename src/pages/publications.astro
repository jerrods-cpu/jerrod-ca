const isJerrod = (author: string) => author.includes("Schwartz");
---

<BaseLayout title="Publications | Jerrod Schwartz">
  <section class="section">
    <div class="container narrow">
      <div class="eyebrow">Scientific work</div>
      <h1>Publications</h1>

      <p class="intro">
        Peer-reviewed publications spanning genomics, molecular diagnostics,
        synthetic biology, and single-molecule biophysics.
      </p>

      <div class="publications">
        {
          publications.map((publication) => (
            <article class="publication">
              <div class="year">{publication.year}</div>

              <div class="publication-content">
                <h2>{publication.title}</h2>

                <p class="authors">
                  {publication.authors.map((author, index) => (
                    <>
                      <span class:list={{ me: isJerrod(author) }}>
                        {author}
                      </span>
                      {index < publication.authors.length - 1 ? ", " : ""}
                    </>
                  ))}
                </p>

                <p class="citation">
                  <em>{publication.journal}</em>{" "}
                  {publication.citation} ({publication.year})
                </p>

                <div class="publication-links">
                  <a
                    href={`https://doi.org/${publication.doi}`}
                    target="_blank"
                    rel="noreferrer"
                  >
                    DOI
                  </a>

                  {publication.pubmed && (
                    <a
                      href={publication.pubmed}
                      target="_blank"
                      rel="noreferrer"
                    >
                      PubMed
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 2.5rem;
  }

  .publications {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .publication {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .publication:last-child {
    border-bottom: 1px solid
      color-mix(in srgb, currentColor 18%, transparent);
  }

  .year {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.55;
    padding-top: 0.2rem;
  }

  .publication h2 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .authors,
  .citation {
    margin: 0.25rem 0;
    line-height: 1.55;
  }

  .authors {
    font-size: 0.95rem;
  }

  .me {
    font-weight: 700;
  }

  .citation {
    font-size: 0.95rem;
    opacity: 0.72;
  }

  .publication-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.55rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .publication-links a {
    text-decoration: none;
  }

  .publication-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .publication {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .year {
      padding-top: 0;
    }
  }
</style>
