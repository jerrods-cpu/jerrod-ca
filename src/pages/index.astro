---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Jerrod Schwartz, Ph.D. | Scientist, Inventor & R&D Leader"
  description="Jerrod Schwartz is a scientist, inventor, and R&D leader working across genomics, molecular diagnostics, computational biology, and biotechnology."
>
  <section class="hero">
    <div class="container hero-grid">

      <div class="hero-copy">
        <div class="eyebrow">Scientist · Inventor · R&D Leader</div>

        <h1>Jerrod Schwartz, Ph.D.</h1>

        <p class="lead">
          I build experimental and computational technologies for
          measuring biology and turn them into scalable scientific
          and clinical platforms.
        </p>

        <p class="current">
          Chief Technology Officer at ChromaCode · formerly Verily /
          Google Life Sciences
        </p>

        <div class="links">
          <a
             href="https://www.linkedin.com/in/jerrod-schwartz-92b1917/"
             target="_blank"
             rel="me"
         >
           LinkedIn
          </a>
          <a href="/publications">Publications</a>
          <a href="/cv">Curriculum Vitae</a>
        </div>
      </div>

      <div class="headshot">
        <img
          src="/images/jerrod-schwartz.jpg"
          alt="Jerrod Schwartz"
        />
      </div>

    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="eyebrow">About</div>

      <h2>Measurement, computation, and biology.</h2>

      <p>
        I am a scientist, inventor, and R&D leader working at the
        intersection of genomics, molecular diagnostics, computational
        biology, and measurement technology.
      </p>

      <p>
        My work has focused on developing new ways to measure biological
        systems and building the experimental and computational
        infrastructure needed to use those measurements at scale.
      </p>

      <p>
        Across these areas, I have been particularly interested in how
        new molecular measurements, computation, and experimental
        iteration can be combined to make previously inaccessible
        biological information measurable and useful.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Selected work</div>

      <div class="work-grid">
        <article>
          <h3>Molecular diagnostics</h3>
          <p>
            Tumor genomics, molecular assay design, digital PCR,
            statistical modeling, and computational analysis.
          </p>
        </article>

        <article>
          <h3>Genomics & multi-omics</h3>
          <p>
            Large-scale genomic measurement, immune profiling, and
            population-scale biological studies.
          </p>
        </article>

        <article>
          <h3>Sequencing & synthetic biology</h3>
          <p>
            Technologies for DNA measurement, gene synthesis, and
            long-range genomic analysis.
          </p>
        </article>

        <article>
          <h3>Single-molecule biophysics</h3>
          <p>
            Molecular imaging and real-time measurements of nucleic-acid
            enzymes.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 92px 0 100px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.65fr);
    gap: 80px;
    align-items: center;
  }

  h1 {
    margin-top: 12px;
    margin-bottom: 26px;
  }

  .lead {
    max-width: 720px;
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .current {
    color: var(--muted);
    margin-top: 26px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
    font-weight: 600;
  }

  .headshot {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
  }

  .headshot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 64px;
    margin-top: 32px;
  }

  .work-grid article {
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }

  .work-grid p {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .hero {
      padding: 60px 0;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .headshot-placeholder {
      max-width: 320px;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
